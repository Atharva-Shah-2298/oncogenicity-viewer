  "PTCH1": {
    "p.Arg135Ter": {
      "references": [
        {
          "pmid": "30610186",
          "oncogenic_claim": "yes",
          "evidence_type": [
            "in_vitro",
            "cell_line_engineering"
          ],
          "functional_evidence": "[OS2] The study established an isogenic PTCH1R135X/+ cellular model using CRISPR/Cas9 to introduce the p.R135X mutation. This mutation resulted in haploinsufficiency of PTCH1, leading to ligand-independent activation of SHH signaling and increased cell proliferation. Treatment with GDC-0449 inhibited this activation and reduced proliferation, indicating the oncogenic potential of the variant. Mechanism: loss-of-function Phenotype: increased proliferation Biochemistry: decreased PTCH1 protein expression and increased GLI1 expression",
          "verbatim_quote": "Using this in vitro isogenic cellular model, we verified that the PTCH1R135X/+ heterozygous mutation causes ligand-independent activation of SHH signalling due to PTCH1 haploinsufficiency.",
          "quote_validated": true
        }
      ],
